{
  "$schema": "https://railway.com/railway.json",
  "name": "wuziqi-frontend",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20"]
        },
        "build": {
          "cmds": ["npm install --production"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "node server.js",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
