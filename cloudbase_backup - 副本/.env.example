# CloudBase 部署环境变量示例
# 复制此文件为 .env 并填入实际值

# ========== 后端配置 ==========
# 允许的跨域请求源 (前端域名)
ALLOWED_ORIGIN=https://your-frontend-domain.com

# 运行环境
NODE_ENV=production

# ========== 前端配置 (构建时使用) ==========
# Socket.io 服务器地址 (CloudBase云托管服务地址)
VITE_SOCKET_URL=https://your-backend-service.tcbns.tencentyun.com

# Supabase 配置 (保持不变)
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
